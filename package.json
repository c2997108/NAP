{
  "name": "nap-nanopore-amplicon-pipeline",
  "version": "1.0.0",
  "private": true,
  "description": "Browser-based Nanopore amplicon splitting and consensus pipeline",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "prepare:pages": "node scripts/prepare-pages.mjs",
    "prepare:pages:db": "node scripts/prepare-pages.mjs --with-annotation-db",
    "test": "node scripts/test-unit.mjs && node scripts/test-integration.mjs && node scripts/test-annotation.mjs && node scripts/test-consensus-memory.mjs && node scripts/test-consensus-recovery.mjs && node scripts/test-cpu-parallel.mjs && node scripts/test-definition-editor.mjs && node scripts/test-service-worker.mjs --docs && node scripts/check-package.mjs",
    "prepare:annotation-db": "node scripts/prepare-annotation-db.mjs",
    "test:annotation": "node scripts/test-annotation.mjs",
    "test:annotation-full": "node scripts/test-annotation-native.mjs && node scripts/test-annotation.mjs --full-db",
    "test:cpu-parallel": "node scripts/test-cpu-parallel.mjs",
    "test:consensus-memory": "node scripts/test-consensus-memory.mjs",
    "test:consensus-recovery": "node scripts/test-consensus-recovery.mjs",
    "test:service-worker": "node scripts/test-service-worker.mjs",
    "test:pages": "node scripts/test-service-worker.mjs --docs",
    "test:editor": "node scripts/test-definition-editor.mjs",
    "test:progress": "node --test tests/demultiplex-progress.test.mjs tests/consensus-progress.test.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "check:package": "node scripts/check-package.mjs"
  },
  "devDependencies": { "playwright": "1.64.0" },
  "license": "MIT"
}
